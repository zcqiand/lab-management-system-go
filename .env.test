# lab-management-system-go 运行环境变量全集（.env / .env.test 的键集合须与此严格相等，L0.5 env 门巡检）。
# 缺键 fail-fast（suite-hard-rules §1），禁止代码里写默认值兜底。
# SERVER_PORT 是 multi-repo-family §6 全家族统一 key（X13 扩展槽，families/lab.md 值表）。
SERVER_PORT=5211

# —— Database（go test 期覆盖（key 集合与 .env.example 严格相等，L0.5）；测试链=lab_test（家族三库分层）） ——
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/lab_test

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
# lab 家族有意差异：token 无 aud claim（rails token_service L6-8），不设 JWT_AUDIENCE。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas IdP 代理链（REQ-2026-023 同款出站键，与 springboot/rails .env.example 同源） ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=lab-management-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
# 服务账号自身登录用的 OAuth client code 形（与 OAuth code 流的 LAB_SAAS_CLIENT_ID 分开配）
LAB_SAAS_SERVICE_CLIENT_ID=lab-management

# —— CORS（勿写成 saas 家族的 SAAS_CORS_*；lab 全家族同值） ——
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5201,http://localhost:5202,http://localhost:5203,http://localhost:5101,http://localhost:5208
